# Supabase project connection. Copy this file to .env.local and fill in the
# values from your Supabase project settings (Project Settings > API).
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security. Never expose to the browser or
# prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy names, still supported for compatibility:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Credentials encryption (existing credentials module)
# 32 bytes random, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Integration secrets encryption (integrations module)
# Separate key from CREDENTIAL_ENCRYPTION_KEY. Same generation command.
# NEVER prefix with NEXT_PUBLIC_. NEVER log. NEVER store in DB.
INTEGRATION_ENCRYPTION_KEY=

# Cron job authorization secret. Used by /api/cron/sync.
# Vercel Cron sends this as "Authorization: Bearer <value>".
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
