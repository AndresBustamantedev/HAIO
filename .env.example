# Supabase project connection. Copy this file to .env.local and fill in the
# values from your Supabase project settings (Project Settings > API).
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security. Never expose to the browser or
# prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy names, still supported for compatibility:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
